{
  "manifest_version": 3,
  "name": "Maskoreshet Better",
  "version": "1.3",
  "description": "שיפורי UX למשכורשת, ללא תלות בשמות משתנים זמניים",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://maskoreshet.co.il/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://maskoreshet.co.il/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ym.cpa1@gmail.com",
      "strict_min_version": "128.0"
    }
  }
}
